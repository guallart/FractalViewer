<Window x:Class="FractalViewer.NewtonRaphson.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FractalViewer.NewtonRaphson"
        mc:Ignorable="d"
        Title="Newton Fractal"
        Width="800"
        Height="600"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Image x:Name="fractal" Stretch="None" SnapsToDevicePixels="True"/>
        <Canvas x:Name="overlay" Width="800" Height="600"
            IsHitTestVisible="False" UseLayoutRounding="True"/>
    </Grid>
</Window>
