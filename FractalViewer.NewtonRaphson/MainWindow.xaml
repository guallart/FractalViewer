<Window x:Class="FractalViewer.NewtonRaphson.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FractalViewer.NewtonRaphson"
        mc:Ignorable="d"
        Title="Newton Fractal"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#151517"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A31"/>
            <Setter Property="Foreground" Value="#D8D8DE"/>
            <Setter Property="BorderBrush" Value="#3A3A43"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="#35353E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="264"/>
        </Grid.ColumnDefinitions>

        <!-- Fractal surface: fixed at the bitmap's native pixel size.
             Background is required so the grid receives mouse input. -->
        <Grid x:Name="surface"
              Grid.Column="0"
              Width="1000" Height="750"
              Background="Transparent"
              ClipToBounds="True"
              Focusable="True">
            <Image x:Name="fractal" Stretch="None"/>
            <Canvas x:Name="overlay" Width="1000" Height="750" IsHitTestVisible="False"/>
        </Grid>

        <!-- Roots panel -->
        <Border Grid.Column="1"
                Background="#1D1D20"
                BorderBrush="#2E2E33"
                BorderThickness="1,0,0,0">
            <DockPanel Margin="18,18,18,18">

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button x:Name="addButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource PanelButton}"
                            Content="Add root"
                            Click="AddRoot_Click"/>
                    <TextBlock Text="Roots"
                               Foreground="#F2F2F4"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom">

                    <Border Background="#232329"
                            BorderBrush="#2E2E36"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12,10"
                            Margin="0,16,0,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="iterationsDown"
                                        Style="{StaticResource StepperButton}"
                                        Content="−"
                                        Click="IterationsDown_Click"/>
                                <TextBlock x:Name="iterationsText"
                                           Width="46"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#EDEDF0"
                                           FontFamily="Consolas"
                                           FontSize="14"/>
                                <Button x:Name="iterationsUp"
                                        Style="{StaticResource StepperButton}"
                                        Content="+"
                                        Click="IterationsUp_Click"/>
                            </StackPanel>
                            <TextBlock Text="Iterations"
                                       Foreground="#A8A8B0"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="viewText"
                               Foreground="#8B8B93"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Drag a marker to move a root, double-click the plane to add one there, right-click a marker to remove it. Drag elsewhere to pan, scroll to zoom. Brackets step the iteration count, R resets the view, Ctrl+R the roots."
                               Foreground="#5E5E66"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <ItemsControl x:Name="rootList" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="20" Height="20"
                                        CornerRadius="3"
                                        Background="{Binding Swatch}"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        VerticalAlignment="Top"
                                        Margin="0,2,12,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Value}"
                                               Foreground="#EDEDF0"
                                               FontFamily="Consolas"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="#7B7B83"
                                               FontSize="10"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource PanelButton}"
                                        Content="Remove"
                                        Padding="7,2"
                                        FontSize="10"
                                        VerticalAlignment="Top"
                                        Margin="8,1,0,0"
                                        IsEnabled="{Binding CanRemove}"
                                        Tag="{Binding}"
                                        Click="RemoveRoot_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </DockPanel>
        </Border>
    </Grid>
</Window>
